#42
let s = {rows:0, valid:0, bad:0, sum_id:0, sum_value:0, active:0, weighted_mod:0, first_id:nil, last_id:nil}
let currentLine = {text:""}
let parseCurrent = () => jsonParse(currentLine.text)
fn consume(line, lineNo) {
    s.rows += 1
    currentLine.text = line
    let r = attempt(parseCurrent)
    if r.ok {
        let v = r.value
        s.valid += 1
        s.sum_id += v.id
        s.sum_value += v.value
        if v.active { s.active += 1 }
        s.weighted_mod = (s.weighted_mod + (v.id+1)*(v.value+1001)) % 1000000007
        if s.first_id == nil { s.first_id = v.id }
        s.last_id = v.id
    } else { s.bad += 1 }
    true
}
let args = argv()
let text = readFile(args[0])
let lines = split("\n",text)
let count = if len(text) == 0 {0} else {if endsWith("\n",text) {len(lines)-1} else {len(lines)}}
for i in range(count) { consume(lines[i],i+1) }
print(jsonStringify(s))
if args[1] == "hold" { input("") }