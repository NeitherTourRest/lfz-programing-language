#42
// recursion_fib: naive (exponential) recursive Fibonacci fib(n).
// Measures recursive-call overhead. N is small because work ~ fib(n).
// Usage: the size N is read from stdin (one integer line).
let n = int(input())
fn fib(k) {
    if k < 2 { return k }
    fib(k - 1) + fib(k - 2)
}
print("RESULT fib=${fib(n)}")
