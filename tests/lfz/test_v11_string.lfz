#42
// v1.1 黑盒：interface-contract §10.7 / semantics §4.2。
assert(endsWith("界","世界"), "v11_string_1")
assert(endsWith("",""), "v11_string_2")
assert(!endsWith("世界","界"), "v11_string_3")
assert(indexOf("界","你🙂世界界") == 3, "v11_string_4")
assert(indexOf("aba","ababa") == 0, "v11_string_5")
assert(indexOf("x","世界") == -1, "v11_string_6")
assert(indexOf("","世界") == 0, "v11_string_7")
assert(padEnd(6,"ab","中") == "中ababa", "v11_string_8")
assert(padStart(6,"ab","中") == "ababa中", "v11_string_9")
assert(padEnd(4,"🙂界","甲") == "甲🙂界🙂", "v11_string_10")
assert(padStart(4,"🙂界","甲") == "🙂界🙂甲", "v11_string_11")
assert(padEnd(2,"x","abc") == "abc", "v11_string_12")
assert(padStart(0,"x","") == "", "v11_string_13")
assert(substring(1,3,"你🙂世界") == "🙂世", "v11_string_14")
assert(substring(-2,99,"abc") == "abc", "v11_string_15")
assert(substring(3,1,"abc") == "", "v11_string_16")
assert(substring(99,100,"abc") == "", "v11_string_17")
assert(substring(0,1,"") == "", "v11_string_18")
assert(("世界" |> substring(0,1)) == "世", "v11_string_19")
assert(contains(2,[1,2,3]), "v11_string_20")
assert(!contains(1,[]), "v11_string_21")
assert(contains([1,2],[[1,2],[3]]), "v11_string_22")
assert(!contains("中",["中文"]), "v11_string_23")
assert(split("","你🙂界")[1] == "🙂", "v11_string_24")
