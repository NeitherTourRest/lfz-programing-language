#42
// ============================================================
// test_int_min.lfz — i64 边界（B12）
// 覆盖: -9223372036854775808 合法；i64::MAX；MIN+MAX 不溢出
// spec: syntax.md §6-B12、interface-contract.md §10.8（一元负号特判）
// 负例（无负号的 9223372036854775808 → SyntaxError）见 fixtures/int_literal_overflow.lfz
// ============================================================

assert(-9223372036854775808 == -9223372036854775808, "i64_min_literal_legal")
assert(-9223372036854775808 < 0, "i64_min_is_negative")
assert(-9223372036854775808 + 1 < 0, "i64_min_plus_one_no_overflow")
assert(9223372036854775807 == 9223372036854775807, "i64_max_literal_legal")
assert(9223372036854775807 > 0, "i64_max_is_positive")
assert(9223372036854775807 - 9223372036854775807 == 0, "i64_max_minus_self")
assert(-9223372036854775808 + 9223372036854775807 == -1, "i64_min_plus_max")
assert(str(-9223372036854775808) == "-9223372036854775808", "i64_min_display")
