#42
// ============================================================
// test_builtins_array.lfz — 核心 / 数组内置（14）
// 覆盖: len range push pop removeAt insert swap slice min max sum sort take drop
// spec: interface-contract.md §10.7（data-last、返回新值不改原容器 A1）;
//       semantics.md §4.5.6（全序）、§4.5.11
// 负例: fixtures/{pop_empty,removeAt_out_of_range,removeAt_negative_out_of_range,
//       insert_negative_index,insert_index_too_large,swap_out_of_range,
//       min_empty,max_empty,sort_mixed_types,sum_overflow}.lfz
// ============================================================

// ---- len：array 元素数 / string Unicode 标量数 ----
assert(len([1, 2, 3]) == 3, "len_array")
assert(len([]) == 0, "len_empty_array")
assert(len("abc") == 3, "len_string")
assert(len("中文") == 2, "len_string_unicode_scalars")
assert(type(len([])) == "int", "len_returns_int")

// ---- range：[0, 1, …, n-1]；n < 0 → 空 ----
assert(range(0) == [], "range_zero_empty")
assert(range(5) == [0, 1, 2, 3, 4], "range_five")
assert(range(-1) == [], "range_negative_empty")
assert(type(range(3)) == "array", "range_returns_array")

// ---- push / pop：返回新数组，不改原容器 ----
let a0 = [1, 2, 3]
let a1 = push(4, a0)
assert(a1 == [1, 2, 3, 4], "push_appends")
assert(a0 == [1, 2, 3], "push_does_not_mutate")
assert(push(1, []) == [1], "push_into_empty")
assert(pop([1, 2, 3]) == [1, 2], "pop_removes_last")
assert(pop([9]) == [], "pop_single")
assert(pop(a0) == [1, 2], "pop_returns_new")
assert(a0 == [1, 2, 3], "pop_does_not_mutate")

// ---- removeAt：支持负索引；返回新数组 ----
assert(removeAt(1, [1, 2, 3]) == [1, 3], "removeAt_middle")
assert(removeAt(0, [1, 2, 3]) == [2, 3], "removeAt_first")
assert(removeAt(-1, [1, 2, 3]) == [1, 2], "removeAt_negative_index")
let r0 = [1, 2, 3]
let r1 = removeAt(1, r0)
assert(r0 == [1, 2, 3], "removeAt_does_not_mutate")

// ---- insert：合法域 i ∈ [0, len]；不支持负索引 ----
assert(insert(0, 9, [1, 2]) == [9, 1, 2], "insert_at_zero")
assert(insert(1, 9, [1, 2]) == [1, 9, 2], "insert_middle")
assert(insert(2, 9, [1, 2]) == [1, 2, 9], "insert_at_len_allowed")
assert(insert(0, 9, []) == [9], "insert_into_empty")
let i0 = [1, 2]
let i1 = insert(1, 9, i0)
assert(i0 == [1, 2], "insert_does_not_mutate")

// ---- swap：支持负索引；返回新数组 ----
assert(swap(0, 2, [1, 2, 3]) == [3, 2, 1], "swap_ends")
assert(swap(0, 0, [1, 2, 3]) == [1, 2, 3], "swap_same_index")
assert(swap(-1, 0, [1, 2, 3]) == [3, 2, 1], "swap_negative_index")
let w0 = [1, 2, 3]
let w1 = swap(0, 1, w0)
assert(w0 == [1, 2, 3], "swap_does_not_mutate")

// ---- slice：下标夹取到 [0, len]；from >= to → 空 ----
assert(slice(0, 2, [1, 2, 3]) == [1, 2], "slice_prefix")
assert(slice(1, 3, [1, 2, 3]) == [2, 3], "slice_suffix")
assert(slice(1, 1, [1, 2, 3]) == [], "slice_from_eq_to_empty")
assert(slice(2, 1, [1, 2, 3]) == [], "slice_from_gt_to_empty")
assert(slice(-5, 100, [1, 2, 3]) == [1, 2, 3], "slice_clamps_both_ends")
assert(slice(0, 100, [1, 2, 3]) == [1, 2, 3], "slice_to_clamped")
let sl0 = [1, 2, 3]
let sl1 = slice(0, 1, sl0)
assert(sl0 == [1, 2, 3], "slice_does_not_mutate")

// ---- min / max：确定性全序（-Inf < 有限 < +Inf < NaN） ----
assert(min([3, 1, 2]) == 1, "min_int")
assert(max([3, 1, 2]) == 3, "max_int")
assert(min([5]) == 5, "min_single")
assert(max([5]) == 5, "max_single")
assert(min([1.5, 0.5, 2.5]) == 0.5, "min_float")
assert(max([1.5, 0.5, 2.5]) == 2.5, "max_float")
assert(min([1.0, float("inf")]) == 1.0, "min_finite_below_inf")
assert(max([1.0, float("inf")]) == float("inf"), "max_inf_wins")
assert(min([float("-inf"), 1.0]) == float("-inf"), "min_neg_inf_wins")
assert(max([float("-inf"), 1.0]) == 1.0, "max_finite_above_neg_inf")

// ---- sum：全 int → int；含 float → float；空 → int 0 ----
assert(sum([1, 2, 3]) == 6, "sum_int")
assert(sum([]) == 0, "sum_empty_zero")
assert(type(sum([])) == "int", "sum_empty_is_int")
assert(sum([1.0, 2.0]) == 3.0, "sum_float")
assert(sum([1, 2.0]) == 3.0, "sum_mixed_is_float")
assert(type(sum([1, 2.0])) == "float", "sum_mixed_type_float")
assert(type(sum([1, 2])) == "int", "sum_int_type")

// ---- sort：升序新数组；确定性全序；稳定性由 sortBy 用例举证 ----
assert(sort([3, 1, 2]) == [1, 2, 3], "sort_ints")
assert(sort([]) == [], "sort_empty")
assert(sort([1]) == [1], "sort_single")
let srt0 = [3, 1, 2]
let srt1 = sort(srt0)
assert(srt0 == [3, 1, 2], "sort_does_not_mutate")
let srtAll = sort([float("nan"), 1.0, float("inf"), float("-inf")])
assert(srtAll[0] == float("-inf"), "sort_all_order_neg_inf_first")
assert(srtAll[1] == 1.0, "sort_all_order_finite_middle")
assert(srtAll[2] == float("inf"), "sort_all_order_inf")
assert(srtAll[3] != srtAll[3], "sort_all_order_nan_last")

// ---- take：n 夹取到 [0, len] ----
assert(take(2, [1, 2, 3]) == [1, 2], "take_prefix")
assert(take(0, [1, 2, 3]) == [], "take_zero")
assert(take(10, [1, 2, 3]) == [1, 2, 3], "take_clamps_high")
assert(take(-1, [1, 2, 3]) == [], "take_clamps_negative")
assert(take(2, []) == [], "take_empty")

// ---- drop：去前 n 个 ----
assert(drop(1, [1, 2, 3]) == [2, 3], "drop_prefix")
assert(drop(0, [1, 2, 3]) == [1, 2, 3], "drop_zero")
assert(drop(3, [1, 2, 3]) == [], "drop_all")
assert(drop(10, [1, 2, 3]) == [], "drop_beyond_len")
