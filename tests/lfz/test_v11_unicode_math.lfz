#42
// v1.1 黑盒：interface-contract §10.7 / semantics §4.2。
assert(ord("A") == 65, "v11_unicode_math_1")
assert(ord("中") == 20013, "v11_unicode_math_2")
assert(ord("🙂") == 128578, "v11_unicode_math_3")
assert(chr(65) == "A", "v11_unicode_math_4")
assert(chr(128578) == "🙂", "v11_unicode_math_5")
assert(ord(chr(0)) == 0, "v11_unicode_math_6")
assert(ord(chr(1114111)) == 1114111, "v11_unicode_math_7")
assert(ord(chr(55295)) == 55295, "v11_unicode_math_8")
assert(ord(chr(57344)) == 57344, "v11_unicode_math_9")
assert(sin(0) == 0.0, "v11_unicode_math_10")
assert(cos(0) == 1.0, "v11_unicode_math_11")
assert(log(1) == 0.0, "v11_unicode_math_12")
assert(exp(0) == 1.0, "v11_unicode_math_13")
assert(abs(sin(1.0)-0.8414709848078965) < 0.000000000001, "v11_unicode_math_14")
assert(abs(cos(1.0)-0.5403023058681398) < 0.000000000001, "v11_unicode_math_15")
assert(abs(log(exp(1.0))-1.0) < 0.000000000001, "v11_unicode_math_16")
assert(type(sin(0)) == "float", "v11_unicode_math_17")
assert(sin(float("inf")) != sin(float("inf")), "v11_unicode_math_18")
assert(cos(float("-inf")) != cos(float("-inf")), "v11_unicode_math_19")
assert(log(-1) != log(-1), "v11_unicode_math_20")
assert(exp(float("nan")) != exp(float("nan")), "v11_unicode_math_21")
assert(log(0) == float("-inf"), "v11_unicode_math_22")
assert(exp(1000) == float("inf"), "v11_unicode_math_23")
assert(exp(float("-inf")) == 0.0, "v11_unicode_math_24")
