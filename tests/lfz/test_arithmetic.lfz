#42
// ============================================================
// test_arithmetic.lfz — 算术 / 比较 / 逻辑 / 一元
// 覆盖: + - * 、== != < <= > >= 、&& || ! 、一元 -、字符串 + 与 *
// spec: semantics.md §4.2（类型化运算符、无隐式转换）
// 负例（类型不符 / 除零）见 fixtures/type_error_add.lfz、zero_division.lfz
// ============================================================

// 算术
assert(1 + 2 == 3, "add_int")
assert(5 - 3 == 2, "sub_int")
assert(4 * 3 == 12, "mul_int")
assert(2 + 3 * 4 == 14, "mul_before_add")

// 一元
assert(-5 == 0 - 5, "unary_minus")
assert(-(3) == -3, "unary_minus_on_parenthesized")

// 逻辑非
assert(!true == false, "logical_not_true")
assert(!false == true, "logical_not_false")
assert(!(1 == 2), "logical_not_on_comparison")

// 比较
assert(1 == 1, "eq")
assert(1 != 2, "neq")
assert(1 < 2, "lt")
assert(2 <= 2, "lte")
assert(3 > 2, "gt")
assert(3 >= 3, "gte")

// 逻辑与/或
assert(true && true, "and_true")
assert(!(true && false), "and_false")
assert(true || false, "or_true")
assert(!(false || false), "or_false")

// 字符串运算
assert("a" + "b" == "ab", "string_concat")
assert("ab" * 2 == "abab", "string_repeat")
assert("x" * 0 == "", "string_repeat_zero")

// 短路求值：右操作数不得被求值（否则 1 / 0 会抛 ZeroDivisionError）
assert(!(false && (1 / 0 == 1)), "and_short_circuits")
assert(true || (1 / 0 == 1), "or_short_circuits")
