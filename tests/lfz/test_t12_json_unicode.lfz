#42
// T12 Unicode、JSON转义和任意字符串键。
assert(jsonParse("\"\\ud83d\\ude42\"") == "🙂", "t12_json_nonbmp")
assert(jsonParse(jsonStringify("🙂")) == "🙂", "t12_json_roundtrip_nonbmp")
assert(jsonParse("\"\\u0000\"") == chr(0), "t12_json_nul")
assert(jsonParse(jsonStringify(chr(0))) == chr(0), "t12_json_roundtrip_nul")
assert(jsonParse("\"\\b\\f\\n\\r\\t\\/\\\\\\\"\"") == (chr(8) + chr(12) + "\n\r\t/\\\""), "t12_json_escapes")
assert(jsonParse(jsonStringify((chr(8) + chr(12) + "\n\r\t/\\\""))) == (chr(8) + chr(12) + "\n\r\t/\\\""), "t12_json_roundtrip_escapes")
assert(jsonParse("\"\${no_eval}\"") == "\${no_eval}", "t12_json_literal_dollar")
assert(jsonParse(jsonStringify("\${no_eval}")) == "\${no_eval}", "t12_json_roundtrip_literal_dollar")
assert(jsonParse("\"中文🙂\"") == "中文🙂", "t12_json_raw_unicode")
assert(jsonParse(jsonStringify("中文🙂")) == "中文🙂", "t12_json_roundtrip_raw_unicode")
let special = jsonParse("{\"\":0,\"a b\":1,\"🙂\":2,\"\${x}\":3,\"\\u0000\":4}")
assert(special[""] == 0, "t12_json_empty_key")
assert(special["a b"] == 1, "t12_json_space_key")
assert(special["🙂"] == 2, "t12_json_nonbmp_key")
assert(special["\${x}"] == 3, "t12_json_dollar_key")
assert(special[chr(0)] == 4, "t12_json_nul_key")
assert(jsonStringify("\${x}/中文🙂") == "\"\${x}/中文🙂\"", "t12_json_no_invalid_dollar_escape")
