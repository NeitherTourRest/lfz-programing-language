#42
// ============================================================
// test_structs.lfz — 结构体：字面量 / 字段访问 / 方法 vs 数据面（A5）/ del
// 覆盖: struct 声明与模板默认值、实例化、`.k` 与 `["k"]` 等价、方法字段（含 self）、
//       keys/values/entries/has/len/显示 均不含方法字段、动态字段、匿名 struct、
//       平拷贝（可变默认值不共享）、del 仅作用数据面（正向）
// spec: syntax.md §3.3/§7; semantics.md §4.5.8/§4.5.9
// 负例（del 方法字段 → FieldError）见 fixtures/del_method_field.lfz
// 负例（del 缺失数据字段 → FieldError）见 fixtures/del_missing_data_field.lfz
// ============================================================

struct Point {
    x: 0,
    y: 0,
    fn norm2() => self.x * self.x + self.y * self.y,
    fn describe() => "(${self.x}, ${self.y})",
}

let p = Point { x: 3, y: 4 }
assert(p.x == 3, "struct_dot_field")
assert(p["y"] == 4, "struct_bracket_field")
assert(p.x == p["x"], "struct_dot_bracket_equivalent")

// ---- 数据字段 .k ≡ ["k"]：写亦等价（semantics §4.5.2：两写法均原地改容器） ----
let rw = Point { x: 1, y: 2 }
rw.x = 10
assert(rw["x"] == 10, "struct_dot_write_seen_via_bracket")
rw["y"] = 20
assert(rw.y == 20, "struct_bracket_write_seen_via_dot")

// ---- 方法字段：`.k()` 与 `["k"]()` 等价（semantics §3.7 L51 / §4.5.8；bug-20260927-01 已修复） ----
assert(p.norm2() == 25, "struct_method_call_dot")
assert(p["norm2"]() == 25, "struct_method_call_bracket")
assert(p.norm2() == p["norm2"](), "struct_method_two_call_forms_equivalent")
assert(type(p["norm2"]) == "function", "struct_method_value_via_bracket")
assert(p.describe() == "(3, 4)", "struct_method_uses_self")
assert(p["describe"]() == "(3, 4)", "struct_method_bracket_uses_self")

// ---- A5 数据面：函数值字段不参与 ----
assert(keys(p) == ["x", "y"], "keys_excludes_methods")
assert(values(p) == [3, 4], "values_excludes_methods")
assert(entries(p) == [["x", 3], ["y", 4]], "entries_excludes_methods")
assert(len(p) == 2, "len_excludes_methods")
assert(has("x", p), "has_data_field_true")
assert(!has("norm2", p), "has_method_field_false")
assert(str(p) == "{x: 3, y: 4}", "display_excludes_methods")

// ---- 模板默认值 ----
struct Named {
    name: "?",
    age: 0,
}
let n = Named { name: "Bob" }
assert(n.age == 0, "template_default_applied")
assert(n.name == "Bob", "template_override_default")

// ---- 平拷贝：可变默认值每实例一份，不共享（B7） ----
struct Bag {
    items: [],
}
let b1 = Bag {}
let b2 = Bag {}
b1.items = push(1, b1.items)
assert(len(b1.items) == 1, "mutable_default_instance_1")
assert(len(b2.items) == 0, "mutable_default_not_shared")

// ---- 动态字段（实例新增，模板不变） ----
let q = Point { x: 1, y: 2 }
q.z = 9
assert(q.z == 9, "dynamic_field_add")
assert(len(q) == 3, "dynamic_field_in_data_face")
let q2 = Point { x: 1, y: 2 }
assert(!has("z", q2), "dynamic_field_not_on_other_instance")

// ---- 方法修改 self ----
struct Counter {
    n: 0,
    fn bump() {
        self.n += 1
    },
    fn value() => self.n,
}
let cc = Counter { n: 0 }
cc.bump()
cc.bump()
assert(cc.value() == 2, "method_mutates_self")

// ---- 方法改 self：两种写法绑定同一实例（bug-20260927-01 修复的端到端回归） ----
cc["bump"]()
assert(cc.value() == 3, "method_bracket_mutates_same_instance")
assert(cc["value"]() == 3, "method_bracket_reads_same_self")
let c1 = Counter { n: 0 }
let c2 = Counter { n: 0 }
c1.bump()
c1.bump()
c2["bump"]()
c2["bump"]()
assert(c1.n == c2.n, "method_two_call_forms_same_final_state")
assert(c2.n == 2, "method_bracket_call_final_state")

// ---- 匿名 struct（字典面孔） ----
let d = { "k": 1, "name": "x" }
assert(d["k"] == 1, "anon_struct_field")
assert(keys(d) == ["k", "name"], "anon_struct_keys_byte_order")
assert(len(d) == 2, "anon_struct_len")

// ---- del 仅作用数据面（正向） ----
let ds = { "a": 1, "b": 2 }
let ds2 = del("a", ds)
assert(keys(ds2) == ["b"], "del_removes_data_field")
assert(keys(ds) == ["a", "b"], "del_returns_new_struct")
assert(!has("a", ds2), "del_updates_data_face")
