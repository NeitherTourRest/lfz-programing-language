{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LFZ benchmark v2 independent manual review",
  "type": "object",
  "required": [
    "kind",
    "run_id",
    "reviewer",
    "functional_report_sha256",
    "manifest_sha256",
    "tasks"
  ],
  "properties": {
    "kind": {
      "const": "INDEPENDENT_MANUAL_REVIEW"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "functional_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tasks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "task",
          "source_sha256",
          "source_review",
          "protocol_review",
          "evidence"
        ],
        "properties": {
          "task": {
            "enum": [
              "B01",
              "B02",
              "B03",
              "B04",
              "B05",
              "B06",
              "B07",
              "B08"
            ]
          },
          "source_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_review": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          },
          "protocol_review": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "description": "Schema only, not review verdicts. Verify each task B01..B08 occurs exactly once and hashes match; PASS requires functional + source + protocol PASS. UNKNOWN/missing never passes."
}
