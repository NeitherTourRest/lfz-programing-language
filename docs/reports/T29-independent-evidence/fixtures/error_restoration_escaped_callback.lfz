#42
let saved={callback:nil}
let result=attempt(()=>map((x)=>{saved.callback=()=>x
 if x==2 { fail("stop") }
 return x},[1,2,3]))
assert(!result.ok)
let last=saved.callback
assert(last()==2)
let later=map((x)=>x+1,[7,8])
assert(later==[8,9])
assert(last()==2)
print(jsonStringify(result.error))
