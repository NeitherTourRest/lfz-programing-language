#42
// LFZ mini-JSON parser + dot-path query
// value = { type: "str"|"num"|"bool"|"null"|"arr"|"obj", ... }
// result = { ok: true, v: value } | { ok: false, msg: string }

fn isDigit(c) => c >= "0" && c <= "9"
fn okVal(v) => ({ ok: true, v: v })
fn errVal(msg) => ({ ok: false, msg: msg })
fn missing() => ({ type: "missing" })

// consume chars[st.i] if it equals ch (bounds-safe; && short-circuits)
fn eat(cs, st, ch) {
    if st.i < len(cs) && cs[st.i] == ch {
        st.i += 1
        return true
    }
    false
}

// consume a literal word (array of chars) at the cursor
fn eatLit(lit, cs, st) {
    if st.i + len(lit) > len(cs) { return false }
    var j = 0
    while j < len(lit) {
        if cs[st.i + j] != lit[j] { return false }
        j += 1
    }
    st.i += len(lit)
    true
}

fn skipWs(cs, st) {
    while st.i < len(cs) {
        let c = cs[st.i]
        if c == " " || c == "\t" || c == "\n" || c == "\r" { st.i += 1 } else { break }
    }
}

// called right after the opening quote was consumed
fn parseString(cs, st) {
    var s = ""
    while st.i < len(cs) {
        let c = cs[st.i]
        st.i += 1
        if c == "\"" { return okVal({ type: "str", s: s }) }
        if c == "\\" {
            if st.i >= len(cs) { return errVal("bad escape at end of input") }
            let e = cs[st.i]
            s = s + (if e == "n" { "\n" } else if e == "t" { "\t" } else if e == "r" { "\r" } else if e == "\"" { "\"" } else if e == "\\" { "\\" } else { e })
            st.i += 1
        } else { s = s + c }
    }
    errVal("unterminated string")
}

fn parseNumber(cs, st) {
    var s = ""
    if eat(cs, st, "-") { s = "-" }
    var digits = 0
    while st.i < len(cs) {
        if !isDigit(cs[st.i]) { break }
        s = s + cs[st.i]
        st.i += 1
        digits += 1
    }
    var isF = false
    if st.i < len(cs) && cs[st.i] == "." {
        isF = true
        s = s + "."
        st.i += 1
        while st.i < len(cs) {
            if !isDigit(cs[st.i]) { break }
            s = s + cs[st.i]
            st.i += 1
            digits += 1
        }
    }
    if digits == 0 { return errVal("invalid number") }
    if isF { return okVal({ type: "num", n: float(s) }) }
    okVal({ type: "num", n: int(s) })
}

// called right after "{" was consumed
fn parseObj(cs, st) {
    var pairs = []
    while true {
        skipWs(cs, st)
        if eat(cs, st, "}") { return okVal({ type: "obj", pairs: pairs }) }
        if st.i >= len(cs) { return errVal("unterminated object") }
        if cs[st.i] != "\"" { return errVal("expected string key at ${st.i}") }
        let kr = parseString(cs, st)
        if !kr.ok { return kr }
        skipWs(cs, st)
        if !eat(cs, st, ":") { return errVal("expected ':' after key") }
        let vr = parseValue(cs, st)
        if !vr.ok { return vr }
        pairs = push([kr.v.s, vr.v], pairs)
        skipWs(cs, st)
        if eat(cs, st, "}") { return okVal({ type: "obj", pairs: pairs }) }
        if !eat(cs, st, ",") { return errVal("expected ',' or '}' in object") }
    }
}

// called right after "[" was consumed
fn parseArr(cs, st) {
    var items = []
    while true {
        skipWs(cs, st)
        if eat(cs, st, "]") { return okVal({ type: "arr", items: items }) }
        let vr = parseValue(cs, st)
        if !vr.ok { return vr }
        items = push(vr.v, items)
        skipWs(cs, st)
        if eat(cs, st, "]") { return okVal({ type: "arr", items: items }) }
        if !eat(cs, st, ",") { return errVal("expected ',' or ']' in array") }
    }
}

fn parseValue(cs, st) {
    skipWs(cs, st)
    if st.i >= len(cs) { return errVal("unexpected end of input") }
    let c = cs[st.i]
    if eat(cs, st, "{") { return parseObj(cs, st) }
    if eat(cs, st, "[") { return parseArr(cs, st) }
    if eat(cs, st, "\"") { return parseString(cs, st) }
    if c == "-" || isDigit(c) { return parseNumber(cs, st) }
    if eatLit(["t", "r", "u", "e"], cs, st) { return okVal({ type: "bool", b: true }) }
    if eatLit(["f", "a", "l", "s", "e"], cs, st) { return okVal({ type: "bool", b: false }) }
    if eatLit(["n", "u", "l", "l"], cs, st) { return okVal({ type: "null" }) }
    errVal("unexpected character '" + c + "' at ${st.i}")
}

fn parse(src) {
    let cs = split("", src)
    let st = { i: 0 }
    let r = parseValue(cs, st)
    if !r.ok { return r }
    skipWs(cs, st)
    if st.i != len(cs) { return errVal("trailing characters at ${st.i}") }
    r
}

// ===== dot-path query =====

fn lookup(key, obj) {
    var j = 0
    while j < len(obj.pairs) {
        if obj.pairs[j][0] == key { return obj.pairs[j][1] }
        j += 1
    }
    missing()
}

fn indexArr(part, arr) {
    let pcs = split("", part)
    var j = 0
    while j < len(pcs) {
        if !isDigit(pcs[j]) { return missing() }
        j += 1
    }
    let idx = int(part)
    if idx < 0 || idx >= len(arr.items) { return missing() }
    arr.items[idx]
}

fn query(root, path) {
    let parts = split(".", path)
    var cur = root
    var j = 0
    while j < len(parts) {
        let p = parts[j]
        if cur.type == "obj" { cur = lookup(p, cur) }
        else if cur.type == "arr" { cur = indexArr(p, cur) }
        else { return errVal("cannot descend into " + cur.type + " at '${p}'") }
        if cur.type == "missing" { return errVal("path '${path}' not found at '${p}'") }
        j += 1
    }
    okVal(cur)
}

// ===== pretty printer =====

fn quote(s) {
    let t = replace("\\", "\\\\", s)
    replace("\"", "\\\"", t)
}

fn indent(n) => repeat(n, "  ")

fn ppObj(pairs, depth) {
    if len(pairs) == 0 { return "{}" }
    var s = "{\n"
    var j = 0
    while j < len(pairs) {
        let sep = if j < len(pairs) - 1 { "," } else { "" }
        s = s + indent(depth + 1) + quote(pairs[j][0]) + ": " + pp(pairs[j][1], depth + 1) + sep + "\n"
        j += 1
    }
    s + indent(depth) + "}"
}

fn ppArr(items, depth) {
    if len(items) == 0 { return "[]" }
    var s = "[\n"
    var j = 0
    while j < len(items) {
        let sep = if j < len(items) - 1 { "," } else { "" }
        s = s + indent(depth + 1) + pp(items[j], depth + 1) + sep + "\n"
        j += 1
    }
    s + indent(depth) + "]"
}

fn pp(v, depth) {
    if v.type == "str" { return quote(v.s) }
    if v.type == "num" { return str(v.n) }
    if v.type == "bool" {
        if v.b { return "true" }
        return "false"
    }
    if v.type == "null" { return "null" }
    if v.type == "arr" { return ppArr(v.items, depth) }
    ppObj(v.pairs, depth)
}

fn show(q) {
    if q.ok { return pp(q.v, 0) }
    "NOT FOUND: " + q.msg
}

// ===== main =====

let doc = "{\"name\": \"lfz\", \"version\": 1.5, \"stable\": true, \"notes\": null, \"tags\": [\"lang\", \"parser\"], \"nested\": {\"a\": [10, 20, {\"b\": \"deep\"}], \"c\": 0}}"
let r = parse(doc)
assert(r.ok, "main document must parse")
let root = r.v

// query self-checks
assert(query(root, "name").v.s == "lfz", "query name")
assert(query(root, "version").v.n == 1.5, "query version")
assert(query(root, "stable").v.b == true, "query stable")
assert(query(root, "notes").v.type == "null", "query notes")
assert(len(query(root, "tags").v.items) == 2, "query tags")
assert(query(root, "tags.1").v.s == "parser", "query tags.1")
assert(query(root, "nested.a.0").v.n == 10, "query nested.a.0")
assert(query(root, "nested.a.1").v.n == 20, "query nested.a.1")
assert(query(root, "nested.a.2.b").v.s == "deep", "query nested.a.2.b")
assert(!query(root, "missing.path").ok, "missing path must fail")
assert(!query(root, "name.0").ok, "descend into string must fail")

// round-trip equality of the crafted document
let txt1 = pp(root, 0)
let r2 = parse(txt1)
assert(r2.ok, "re-parse of pretty output")
assert(r2.v == root, "round-trip deep equality")
assert(pp(r2.v, 0) == txt1, "pretty print idempotent")

// literal / empty-container edges
assert(parse("-42").v.n == -42, "negative int")
assert(parse("3.25").v.n == 3.25, "float")
assert(parse("{}").v.type == "obj", "empty obj")
assert(parse("[]").v.type == "arr", "empty arr")

// escaped string round-trip
let docE = "{\"msg\": \"say \\\"hi\\\" now\"}"
let rE = parse(docE)
assert(rE.ok && rE.v.pairs[0][1].s == "say \"hi\" now", "escape decoded")
assert(parse(pp(rE.v, 0)).v == rE.v, "escaped round-trip")

// malformed inputs must be rejected
assert(!parse("{\"a\": 1").ok, "unterminated obj fails")
assert(!parse("[1, 2").ok, "unterminated arr fails")
assert(!parse("{\"a\" 1}").ok, "missing colon fails")
assert(!parse("{\"a\": ~}").ok, "bad char fails")
assert(!parse("{\"a\": 1} junk").ok, "trailing junk fails")
assert(!parse("tru").ok, "bad literal fails")
assert(!parse("1.2.3").ok, "bad number fails")

// ===== demo output =====

print("== LFZ mini JSON parser ==")
print("")
print("-- source --")
print(doc)
print("")
print("-- pretty-printed --")
print(pp(root, 0))
print("")
print("-- dot-path queries --")
print("name         -> ${show(query(root, "name"))}")
print("version      -> ${show(query(root, "version"))}")
print("stable       -> ${show(query(root, "stable"))}")
print("notes        -> ${show(query(root, "notes"))}")
print("tags         -> ${show(query(root, "tags"))}")
print("tags.1       -> ${show(query(root, "tags.1"))}")
print("nested.a.0   -> ${show(query(root, "nested.a.0"))}")
print("nested.a.2.b -> ${show(query(root, "nested.a.2.b"))}")
print("missing.path -> ${show(query(root, "missing.path"))}")
print("name.0       -> ${show(query(root, "name.0"))}")
print("")
print("-- malformed inputs (rejected, with message) --")
let b1 = parse("{\"a\": 1")
let b2 = parse("[1, 2")
let b4 = parse("{\"a\": ~}")
print("{\"a\": 1      -> ${b1.msg}")
print("[1, 2         -> ${b2.msg}")
print("{\"a\": ~}      -> ${b4.msg}")
print("")
print("round-trip: pretty -> parse -> pretty is identical, all asserts passed")
