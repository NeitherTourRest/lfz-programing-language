#42
// 算术表达式求值器：词法分析 + 递归下降语法分析 + 求值
// 文法：expr := term (("+"|"-") term)*   term := factor (("*"|"/") factor)*
//       factor := num | id | "-" factor | "(" expr ")"
struct Tok { kind: "", text: "", num: 0.0, pos: 0 }
struct Node { kind: "", val: 0.0, name: "", op: "", left: nil, right: nil }
struct Step { ok: true, msg: "", pos: 0, node: nil }
struct LR { ok: true, msg: "", tokens: [] }
struct Res { ok: true, value: 0.0, msg: "" }
fn isDigit(c) => c >= "0" && c <= "9"
fn isLetter(c) => (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_"
// 越界安全的取字符（LFZ 无字符串下标，且 && 不短路，故用 sentinel）
fn charAt(chars, i) {
    if i < len(chars) { chars[i] } else { "" }
}
fn tokenize(src) {
    let chars = split("", src)
    var tokens = []
    var i = 0
    while i < len(chars) {
        var c = chars[i]
        if c == " " || c == "\t" {
            i += 1
        } else if isDigit(c) {
            var text = ""
            while isDigit(charAt(chars, i)) {
                text = text + charAt(chars, i)
                i += 1
            }
            if charAt(chars, i) == "." {
                if isDigit(charAt(chars, i + 1)) {
                    text = text + "."
                    i += 1
                    while isDigit(charAt(chars, i)) {
                        text = text + charAt(chars, i)
                        i += 1
                    }
                }
            }
            tokens = push(Tok { kind: "num", text: text, num: float(text), pos: i }, tokens)
        } else if isLetter(c) {
            var text = ""
            while isLetter(charAt(chars, i)) || isDigit(charAt(chars, i)) {
                text = text + charAt(chars, i)
                i += 1
            }
            tokens = push(Tok { kind: "id", text: text, pos: i }, tokens)
        } else if c == "+" || c == "-" || c == "*" || c == "/" || c == "(" || c == ")" {
            tokens = push(Tok { kind: "op", text: c, pos: i }, tokens)
            i += 1
        } else {
            return LR { ok: false, msg: "非法字符 '" + c + "'（位置 " + str(i + 1) + "）" }
        }
    }
    tokens = push(Tok { kind: "end", pos: i }, tokens)
    LR { ok: true, tokens: tokens }
}
fn parseExpr(toks, pos) {
    var s = parseTerm(toks, pos)
    if s.ok == false { return s }
    var left = s.node
    var p = s.pos
    while p < len(toks) {
        var t = toks[p]
        if t.kind == "op" && (t.text == "+" || t.text == "-") {
            var s2 = parseTerm(toks, p + 1)
            if s2.ok == false { return s2 }
            left = Node { kind: "bin", op: t.text, left: left, right: s2.node }
            p = s2.pos
        } else {
            break
        }
    }
    Step { ok: true, pos: p, node: left }
}
fn parseTerm(toks, pos) {
    var s = parseFactor(toks, pos)
    if s.ok == false { return s }
    var left = s.node
    var p = s.pos
    while p < len(toks) {
        var t = toks[p]
        if t.kind == "op" && (t.text == "*" || t.text == "/") {
            var s2 = parseFactor(toks, p + 1)
            if s2.ok == false { return s2 }
            left = Node { kind: "bin", op: t.text, left: left, right: s2.node }
            p = s2.pos
        } else {
            break
        }
    }
    Step { ok: true, pos: p, node: left }
}
fn parseFactor(toks, pos) {
    var t = toks[pos]
    if t.kind == "num" {
        return Step { ok: true, pos: pos + 1, node: Node { kind: "num", val: t.num } }
    }
    if t.kind == "id" {
        return Step { ok: true, pos: pos + 1, node: Node { kind: "var", name: t.text } }
    }
    if t.kind == "op" && t.text == "-" {
        var s = parseFactor(toks, pos + 1)
        if s.ok == false { return s }
        return Step { ok: true, pos: s.pos, node: Node { kind: "neg", left: s.node } }
    }
    if t.kind == "op" && t.text == "(" {
        var s = parseExpr(toks, pos + 1)
        if s.ok == false { return s }
        if toks[s.pos].kind != "rparen" {
            return Step { ok: false, msg: "缺少 ')'（位置 " + str(toks[s.pos].pos + 1) + "）" }
        }
        return Step { ok: true, pos: s.pos + 1, node: s.node }
    }
    if t.kind == "end" {
        return Step { ok: false, msg: "表达式意外结束（位置 " + str(toks[pos].pos + 1) + "）" }
    }
    Step { ok: false, msg: "意外记号 '" + t.text + "'（位置 " + str(toks[pos].pos + 1) + "）" }
}
fn evalNode(node, vars) {
    if node.kind == "num" {
        return Res { ok: true, value: node.val }
    }
    if node.kind == "var" {
        if has(node.name, vars) {
            return Res { ok: true, value: vars[node.name] }
        }
        return Res { ok: false, msg: "未定义的变量 '" + node.name + "'" }
    }
    if node.kind == "neg" {
        var r = evalNode(node.left, vars)
        if r.ok == false { return r }
        return Res { ok: true, value: -r.value }
    }
    if node.kind == "bin" {
        var l = evalNode(node.left, vars)
        if l.ok == false { return l }
        var r = evalNode(node.right, vars)
        if r.ok == false { return r }
        if node.op == "/" && r.value == 0.0 {
            return Res { ok: false, msg: "除以零（除数为 0）" }
        }
        var v = 0.0
        if node.op == "+" { v = l.value + r.value }
        if node.op == "-" { v = l.value - r.value }
        if node.op == "*" { v = l.value * r.value }
        if node.op == "/" { v = l.value / r.value }
        return Res { ok: true, value: v }
    }
    Res { ok: false, msg: "未知节点类型 '" + node.kind + "'" }
}
fn evaluate(src, vars) {
    var lr = tokenize(src)
    if lr.ok == false { return Res { ok: false, msg: lr.msg } }
    var s = parseExpr(lr.tokens, 0)
    if s.ok == false { return Res { ok: false, msg: s.msg } }
    if s.pos != len(lr.tokens) - 1 {
        return Res { ok: false, msg: "多余内容 '" + lr.tokens[s.pos].text + "'（位置 " + str(lr.tokens[s.pos].pos + 1) + "）" }
    }
    evalNode(s.node, vars)
}
fn tokLine(t) {
    if t.kind == "end" { return "<end>" }
    if t.kind == "num" { return "num(" + t.text + ")" }
    t.kind + "('" + t.text + "')"
}
fn show(src) {
    var r = evaluate(src, {})
    if r.ok { return "  " + src + "  =>  " + str(r.value) }
    "  " + src + "  =>  ERROR: " + r.msg
}
print("== 算术表达式求值器（词法 + 递归下降）==")
print("-- 1) 词法分析 --")
let lr = tokenize("12 + x * (3 - 1.5)")
print("  记号: " + join(" ", map((t) => tokLine(t), lr.tokens)))
print("-- 2) 递归下降求值（优先级 / 左结合 / 一元负号）--")
let good = ["1+2*3", "(1+2)*3", "10-4-3", "20/4/2", "2+3*4-8/2", "-5+3", "--5", "-(2+3)*2", "1.5*2", "7/2"]
for e in good { print(show(e)) }
print("-- 3) 变量表 --")
var tab = { }
tab["x"] = 3.0
tab["y"] = 4.0
print(show("x*y+1"))
print("  表内容:")
for k in tab { print("    " + k + " = " + str(tab[k])) }
print("-- 4) 错误处理（清晰报错）--")
let bad = ["1/0", "nope + 1", "(1+2", "1+", "1 $ 2", "1 2", ""]
for e in bad { print(show(e)) }
print("-- 5) 自检（assert 致命 / check 非致命）--")
assert(evaluate("1+2*3", {}).value == 7.0, "1+2*3 == 7")
assert(evaluate("(1+2)*3", {}).value == 9.0, "(1+2)*3 == 9")
assert(evaluate("10-4-3", {}).value == 3.0, "10-4-3 == 3")
assert(evaluate("20/4/2", {}).value == 2.5, "20/4/2 == 2.5")
assert(evaluate("2+3*4-8/2", {}).value == 10.0, "2+3*4-8/2 == 10")
assert(evaluate("-5+3", {}).value == -2.0, "-5+3 == -2")
assert(evaluate("--5", {}).value == 5.0, "--5 == 5")
assert(evaluate("-(2+3)*2", {}).value == -10.0, "-(2+3)*2 == -10")
assert(evaluate("1.5*2", {}).value == 3.0, "1.5*2 == 3")
assert(evaluate("7/2", {}).value == 3.5, "7/2 == 3.5")
assert(evaluate("x*y+1", tab).value == 13.0, "x*y+1 == 13")
assert(evaluate("1/0", {}).ok == false, "除以零应报错")
assert(evaluate("nope + 1", {}).ok == false, "未定义变量应报错")
assert(evaluate("(1+2", {}).ok == false, "缺右括号应报错")
assert(evaluate("1+", {}).ok == false, "意外结束应报错")
assert(evaluate("1 $ 2", {}).ok == false, "非法字符应报错")
assert(evaluate("1 2", {}).ok == false, "多余内容应报错")
assert(evaluate("", {}).ok == false, "空输入应报错")
check(evaluate("9/0", {}).ok == false, "9/0 应报错（软校验，不中断）")
print("OK: 全部自检通过")
