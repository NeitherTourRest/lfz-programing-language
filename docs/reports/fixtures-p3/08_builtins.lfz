#42
print(len([1, 2, 3]))
print(len("héllo"))
print(range(4))
print(range(-2))
print(push(4, [1, 2, 3]))
print(pop([1, 2, 3]))
print(removeAt(-1, [1, 2, 3]))
print(insert(1, 9, [1, 2, 3]))
print(swap(0, -1, [1, 2, 3]))
print(slice(1, 3, [1, 2, 3, 4]))
print(min([3, 1, 2]))
print(max([3, 1, 2]))
print(sum([1, 2, 3]))
print(sum([1, 2.5, 3]))
print(take(2, [1, 2, 3]))
print(drop(2, [1, 2, 3]))
print(sort([3, 1, 2]))
print(sortBy((x) => 0 - x, [1, 2, 3]))
print(reduce((acc, x) => acc + x, 0, [1, 2, 3]))
print(minBy((x) => 0 - x, [1, 2, 3]))
print(maxBy((x) => x, [1, 2, 3]))
print(map((x) => x + 1, [1, 2, 3]))
print(filter((x) => x > 1, [1, 2, 3]))
print(str(42))
print(str(1.0))
print(str([1, "a"]))
print(int("42"))
print(int(2.9))
print(float("1.5"))
print(type(1))
print(type([1]))
print(abs(-3))
print(abs(-3.0))
print(floor(3.7))
print(ceil(3.2))
print(round(2.5))
print(round(3.5))
print(sqrt(4))
print(sqrt(-1))
print(pow(2, 10))
print(div(7, 2))
print(trim("  hi  "))
print(upper("abc"))
print(lower("ABC"))
print(replace("a", "b", "aaa"))
print(repeat(3, "ab"))
print(repeat(0, "ab"))
print(startsWith("he", "hello"))
print(split(" ", "a b c"))
print(split("", "abc"))
print(join("-", ["a", "b", "c"]))
print(has("k", { k: 1 }))
print(del("k", { k: 1, j: 2 }))
print(keys({ b: 1, a: 2 }))
print(values({ b: 1, a: 2 }))
print(entries({ b: 1, a: 2 }))
each((x) => print(x), [7, 8])
