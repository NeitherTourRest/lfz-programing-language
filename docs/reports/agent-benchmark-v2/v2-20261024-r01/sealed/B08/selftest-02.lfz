#42
fn solve(inputPath, outputPath) {
    let lines = split("\n", readFile(inputPath))
    let rows = map((i) => "", range(len(lines) + 1))
    rows[0] = "index,value,running\n"
    var count = 0
    var total = 0
    for line in lines {
        let valueText = trim(line)
        if valueText != "" {
            let value = int(valueText)
            count += 1
            total += value
            rows[count] = "${count},${value},${total}\n"
        }
    }
    writeFile(outputPath, join("", rows))
    { count: count, total: total }
}

assert(readFile("自测 输出.csv") == "index,value,running\n1,3,3\n2,-1,2\n3,0,2\n4,-2,0\n", "prior process output")
let original = readFile("自测 输入.txt")
assert(solve("empty.txt", "自测 输出.csv") == {count:0,total:0}, "overwrite to empty")
assert(readFile("自测 输出.csv") == "index,value,running\n", "old tail fully removed")
assert(solve("large.txt", "自测 输出.csv") == {count:2,total:1}, "overwrite to populated")
assert(readFile("自测 输出.csv") == "index,value,running\n1,9007199254740993,9007199254740993\n2,-9007199254740992,1\n", "second overwrite exact")
assert(readFile("自测 输入.txt") == original, "original source preserved across processes")
print("PASS: independent process overwrites existing output with shorter header and populated content")
