#42
fn solve(inputPath, outputPath) {
    let lines = split("\n", readFile(inputPath))
    let rows = map((i) => "", range(len(lines) + 1))
    rows[0] = "index,value,running\n"
    var count = 0
    var total = 0
    for line in lines {
        let valueText = trim(line)
        if valueText != "" {
            let value = int(valueText)
            count += 1
            total += value
            rows[count] = "${count},${value},${total}\n"
        }
    }
    writeFile(outputPath, join("", rows))
    { count: count, total: total }
}
let inputPath = "自测 输入.txt"
let outputPath = "自测 输出.csv"
let original = "  +003 \r\n\t\r\n-1\n0\r\n -0002 \n\n"
writeFile(inputPath, original)
writeFile(outputPath, "stale content to be replaced completely and removed")
assert(solve(inputPath, outputPath) == {count:4,total:0}, "mixed result")
assert(readFile(outputPath) == "index,value,running\n1,3,3\n2,-1,2\n3,0,2\n4,-2,0\n", "mixed exact output")
assert(readFile(inputPath) == original, "input unchanged")
writeFile("empty.txt", "")
assert(solve("empty.txt", "empty.csv") == {count:0,total:0}, "empty result")
assert(readFile("empty.csv") == "index,value,running\n", "empty header")
writeFile("blank.txt", " \r\n\t\n\r\n ")
assert(solve("blank.txt", "blank.csv") == {count:0,total:0}, "blank result")
assert(readFile("blank.csv") == "index,value,running\n", "blank header")
writeFile("limit.txt", join("\n", map((i) => "1", range(128))))
assert(solve("limit.txt", "limit.csv") == {count:128,total:128}, "128 result")
assert(readFile("limit.csv") == "index,value,running\n" + join("", map((i) => "${i + 1},1,${i + 1}\n", range(128))), "128 exact output")
writeFile("large.txt", "9007199254740993\n-9007199254740992")
assert(solve("large.txt", "large.csv") == {count:2,total:1}, "large integer result")
assert(readFile("large.csv") == "index,value,running\n1,9007199254740993,9007199254740993\n2,-9007199254740992,1\n", "large exact output")
print("PASS: mixed CRLF/LF, signs, leading zeros, blank/empty, 128 lines, exact integers, unchanged input")
