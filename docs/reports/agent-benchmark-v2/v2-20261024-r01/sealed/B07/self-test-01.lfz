#42
// ASCII 字母分词；索引在任何 query 查找之前完整构建。
fn solve(text, queries) {
    let chars = split("", text)
    let capacity = len(chars)
    let wordChars = map((i) => "", range(capacity))
    let tokens = map((i) => "", range(capacity))
    let index = {}
    var width = 0
    var tokenCount = 0
    // 末尾空格负责提交最后一个单词，也适用于空文本。
    for c in push(" ", chars) {
        let code = ord(c)
        if (code >= 65 && code <= 90) || (code >= 97 && code <= 122) {
            wordChars[width] = lower(c)
            width += 1
        } else {
            if width > 0 {
                let word = join("", slice(0, width, wordChars))
                tokens[tokenCount] = word
                tokenCount += 1
                if has(word, index) {
                    index[word].count += 1
                } else {
                    index[word] = { count: 1, used: 0, positions: [] }
                }
                width = 0
            }
        }
    }
    // 依词频一次分配位置数组，避免逐次 push 复制已有位置。
    for word in index {
        index[word].positions = map((i) => 0, range(index[word].count))
    }
    var pos = 0
    while pos < tokenCount {
        let word = tokens[pos]
        let entry = index[word]
        entry.positions[entry.used] = pos
        entry.used += 1
        pos += 1
    }
    let result = map((i) => nil, range(len(queries)))
    var q = 0
    while q < len(queries) {
        let normalized = lower(queries[q])
        if has(normalized, index) {
            let entry = index[normalized]
            result[q] = [normalized, entry.count, entry.positions]
        } else {
            result[q] = [normalized, 0, []]
        }
        q += 1
    }
    result
}
assert(solve("Cat, dog CAT!", ["CAT", "bird"]) == [["cat", 2, [0, 2]], ["bird", 0, []]], "sample")
assert(solve("", ["A", "a"]) == [["a", 0, []], ["a", 0, []]], "empty text")
assert(solve("123!中😀--", ["a"]) == [["a", 0, []]], "no words")
assert(solve("A中B😀a1b_ÉCKD", ["a", "B", "c", "d", "K"]) == [["a", 2, [0, 2]], ["b", 2, [1, 3]], ["c", 1, [4]], ["d", 1, [5]], ["k", 0, []]], "unicode separators")
assert(solve("let VAR fn self true return", ["LET", "self", "True", "return"]) == [["let", 1, [0]], ["self", 1, [3]], ["true", 1, [4]], ["return", 1, [5]]], "keyword keys")
assert(solve("One two one", ["ONE", "one", "TWO"]) == [["one", 2, [0, 2]], ["one", 2, [0, 2]], ["two", 1, [1]]], "duplicate query")
assert(solve("Tail", []) == [], "empty query")
assert(solve("ABC", ["ABC", "AB"]) == [["abc", 1, [0]], ["ab", 0, []]], "last token")
let many = solve(repeat(2048, "a "), ["A", "b"])
assert(many[0][1] == 2048, "max length repeated count")
assert(many[0][2] == range(2048), "max length repeated positions")
assert(many[1] == ["b", 0, []], "absent in large text")
let longWord = repeat(4096, "Z")
assert(solve(longWord, [repeat(64, "z")]) == [[repeat(64, "z"), 0, []]], "long token")
print("PASS: 13 assertions")
