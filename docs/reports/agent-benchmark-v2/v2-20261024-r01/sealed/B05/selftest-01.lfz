#42
// 二维 DP 按原下标顺序加入物品，相同价值保持不选当前物品。
fn solve(items, capacity) {
    let n = len(items)
    let dp = map((i) => nil, range(n + 1))
    var row = 0
    while row <= n {
        dp[row] = map((c) => 0, range(capacity + 1))
        row += 1
    }
    var i = 1
    while i <= n {
        let weight = items[i - 1][0]
        let value = items[i - 1][1]
        var c = 0
        while c <= capacity {
            dp[i][c] = dp[i - 1][c]
            if weight <= c {
                let candidate = dp[i - 1][c - weight] + value
                if candidate > dp[i - 1][c] {
                    dp[i][c] = candidate
                }
            }
            c += 1
        }
        i += 1
    }
    let chosen = map((k) => false, range(n))
    var remaining = capacity
    var back = n
    while back > 0 {
        if dp[back][remaining] > dp[back - 1][remaining] {
            chosen[back - 1] = true
            remaining -= items[back - 1][0]
        }
        back -= 1
    }
    let indices = filter((k) => chosen[k], range(n))
    ({ value: dp[n][capacity], indices: indices })
}

fn expect(items, capacity, value, indices) {
    let result = solve(items, capacity)
    assert(result.value == value, "optimal value")
    assert(result.indices == indices, "deterministic indices")
    var weight = 0
    var total = 0
    var last = -1
    for index in result.indices {
        assert(index > last, "ascending unique indices")
        weight += items[index][0]
        total += items[index][1]
        last = index
    }
    assert(weight <= capacity, "feasible")
    assert(total == result.value, "consistent value")
}
expect([], 0, 0, [])
expect([], 80, 0, [])
expect([[1, 5]], 0, 0, [])
expect([[81, 100], [90, 200]], 80, 0, [])
expect([[2, 7]], 1, 0, [])
expect([[2, 7]], 2, 7, [0])
expect([[2, 7]], 4, 7, [0])
expect([[1, 5], [1, 5], [1, 5]], 2, 10, [0, 1])
expect([[2, 5], [1, 5]], 2, 5, [0])
expect([[1, 3], [1, 3], [2, 6]], 2, 6, [0, 1])
expect([[1, 0], [2, 0]], 3, 0, [])
expect([[2, 3], [3, 4], [4, 5], [5, 8]], 5, 8, [3])
expect([[80, 9223372036854775807]], 80, 9223372036854775807, [0])
expect([[1, 9223372036854775800], [1, 7]], 2, 9223372036854775807, [0, 1])
expect(map((i) => [3, 1], range(24)), 80, 24, range(24))
print("PASS: 15 self-authored cases with interface and consistency assertions")
