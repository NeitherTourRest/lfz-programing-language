#42
fn solve(source) {
    let chars = split("", source)
    let n = len(chars)
    if n == 0 {
        return []
    }
    let buffer = map((i) => "", range(n))
    let fields = map((i) => "", range(n + 1))
    let rows = map((i) => nil, range(n + 1))
    var used = 0
    var fieldCount = 0
    var rowCount = 0
    var quoted = false
    var endedLine = false
    var i = 0
    while i < n {
        let c = chars[i]
        endedLine = false
        if quoted {
            if c == "\"" {
                if i + 1 < n && chars[i + 1] == "\"" {
                    buffer[used] = "\""
                    used += 1
                    i += 1
                } else {
                    quoted = false
                }
            } else {
                buffer[used] = c
                used += 1
            }
        } else {
            if c == "\"" {
                quoted = true
            } else if c == "," {
                fields[fieldCount] = join("", slice(0, used, buffer))
                fieldCount += 1
                used = 0
            } else if c == "\n" || c == "\r" {
                fields[fieldCount] = join("", slice(0, used, buffer))
                fieldCount += 1
                rows[rowCount] = slice(0, fieldCount, fields)
                rowCount += 1
                fieldCount = 0
                used = 0
                endedLine = true
                if c == "\r" && i + 1 < n && chars[i + 1] == "\n" {
                    i += 1
                }
            } else {
                buffer[used] = c
                used += 1
            }
        }
        i += 1
    }
    if !endedLine {
        fields[fieldCount] = join("", slice(0, used, buffer))
        fieldCount += 1
        rows[rowCount] = slice(0, fieldCount, fields)
        rowCount += 1
    }
    slice(0, rowCount, rows)
}
assert(solve("") == [], "empty")
assert(solve("a,b\n") == [["a", "b"]], "trailing LF")
assert(solve("a,") == [["a", ""]], "trailing comma")
assert(solve("\n") == [[""]], "empty LF row")
assert(solve("\r\n") == [[""]], "empty CRLF row")
assert(solve("\n\n") == [[""], [""]], "two empty rows")
assert(solve(",") == [["", ""]], "two empty fields")
assert(solve(",,\r\n") == [["", "", ""]], "three empties")
assert(solve("\"\"") == [[""]], "quoted empty")
assert(solve("\"a,b\",c") == [["a,b", "c"]], "quoted comma")
assert(solve("\"a\"\"b\",\"\"\"\"") == [["a\"b", "\""]], "escaped quotes")
assert(solve("\"a\nb\",\"c\r\nd\"\r\n") == [["a\nb", "c\r\nd"]], "preserved line endings")
assert(solve(" 中文 ,😀,\"🦊,中\"\n") == [[" 中文 ", "😀", "🦊,中"]], "unicode spaces")
assert(solve("a\r\nb\nc") == [["a"], ["b"], ["c"]], "mixed lines")
assert(solve("a\n,") == [["a"], ["", ""]], "final empty row fields")
assert(solve("a,b\n\n") == [["a", "b"], [""]], "final empty row")
assert(solve("\"\n\"") == [["\n"]], "quoted final newline")
assert(solve("\"x\",\r\n\"\",z") == [["x", ""], ["", "z"]], "reset buffers")
assert(solve(repeat(2048, "x")) == [[repeat(2048, "x")]], "max single field")
assert(len(solve(repeat(2048, "\n"))) == 2048, "max rows")
assert(len(solve(repeat(2048, ","))[0]) == 2049, "max fields")
print("PASS: 21 own assertions")
