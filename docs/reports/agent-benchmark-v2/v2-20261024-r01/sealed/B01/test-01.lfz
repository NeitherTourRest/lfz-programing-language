#42
// Recursive descent: expression -> term -> unary -> integer/parentheses.
fn b01_skip(cs, start) {
    var p = start
    while p < len(cs) && cs[p] == " " {
        p += 1
    }
    p
}

fn b01_unary(cs, start) {
    var p = b01_skip(cs, start)
    var negative = false
    while p < len(cs) && (cs[p] == "+" || cs[p] == "-") {
        if cs[p] == "-" {
            negative = !negative
        }
        p = b01_skip(cs, p + 1)
    }
    if cs[p] == "(" {
        let inner = b01_expr(cs, p + 1)
        var value = inner[0]
        if negative {
            value = -value
        }
        return [value, b01_skip(cs, inner[1]) + 1]
    }
    var value = 0
    while p < len(cs) {
        let code = ord(cs[p])
        if code < 48 || code > 57 {
            break
        }
        let digit = code - 48
        if negative {
            value = value * 10 - digit
        } else {
            value = value * 10 + digit
        }
        p += 1
    }
    [value, p]
}

fn b01_term(cs, start) {
    let first = b01_unary(cs, start)
    var value = first[0]
    var p = b01_skip(cs, first[1])
    while p < len(cs) && (cs[p] == "*" || cs[p] == "/") {
        let op = cs[p]
        let rhs = b01_unary(cs, p + 1)
        if op == "*" {
            value = value * rhs[0]
        } else {
            value = div(value, rhs[0])
        }
        p = b01_skip(cs, rhs[1])
    }
    [value, p]
}

fn b01_expr(cs, start) {
    let first = b01_term(cs, start)
    var value = first[0]
    var p = b01_skip(cs, first[1])
    while p < len(cs) && (cs[p] == "+" || cs[p] == "-") {
        let op = cs[p]
        let rhs = b01_term(cs, p + 1)
        if op == "+" {
            value = value + rhs[0]
        } else {
            value = value - rhs[0]
        }
        p = b01_skip(cs, rhs[1])
    }
    [value, p]
}

fn solve(source) {
    let chars = split("", source)
    let result = b01_expr(chars, 0)
    result[0]
}
assert(solve("2 * (3 + 4) - 5") == 9, "precedence")
assert(solve("-7 / 2") == -4, "floor")
assert(solve("7 / -2") == -4, "negative divisor")
assert(solve("-7 / -2") == 3, "both negative")
assert(solve("20 / 3 / 2") == 3, "division left associativity")
assert(solve("20 - 3 - 2") == 15, "subtraction left associativity")
assert(solve("  - + - - + 5 ") == -5, "unary signs and spaces")
assert(solve("1--2*-(-3)") == 7, "binary adjacent unary")
assert(solve("((2 + 3) * (4 - (8 / 3)))") == 10, "nesting")
assert(solve("0") == 0, "zero")
assert(solve("0000012 + 03") == 15, "leading zeros")
assert(solve("9223372036854775807") == 9223372036854775807, "maximum")
assert(solve("-9223372036854775808") == (-9223372036854775807 - 1), "minimum")
assert(solve("-(9223372036854775807) - 1") == (-9223372036854775807 - 1), "minimum via expression")
assert(type(solve("8 / 2")) == "int", "return type")
assert(solve("9+8*7-6/4") == 64, "mixed")
print("16 assertions passed")
