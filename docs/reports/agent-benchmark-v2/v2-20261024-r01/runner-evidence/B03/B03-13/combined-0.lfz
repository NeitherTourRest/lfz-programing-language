#42
fn bucket_hash(key) {
    var code_sum = 0
    for c in split("", key) {
        code_sum = (code_sum + ord(c)) % 8
    }
    code_sum
}

fn solve(operations) {
    let buckets = [[], [], [], [], [], [], [], []]
    let results = map((i) => nil, range(len(operations)))
    var count = 0
    var result_index = 0
    for operation in operations {
        let action = operation[0]
        if action == "size" {
            results[result_index] = count
        } else {
            let key = operation[1]
            let bucket_index = bucket_hash(key)
            var found = -1
            var i = 0
            while i < len(buckets[bucket_index]) {
                if buckets[bucket_index][i][0] == key {
                    found = i
                    break
                }
                i += 1
            }
            if action == "set" {
                if found == -1 {
                    buckets[bucket_index] = push([key, operation[2]], buckets[bucket_index])
                    count += 1
                } else {
                    buckets[bucket_index][found][1] = operation[2]
                }
                results[result_index] = nil
            } else if action == "get" {
                if found != -1 {
                    results[result_index] = buckets[bucket_index][found][1]
                }
            } else if action == "has" {
                results[result_index] = found != -1
            } else if action == "delete" {
                results[result_index] = found != -1
                if found != -1 {
                    buckets[bucket_index] = removeAt(found, buckets[bucket_index])
                    count -= 1
                }
            }
        }
        result_index += 1
    }
    results
}

let __bench_arg_0 = [["set","key0",0],["set","key1",1],["set","key2",2],["set","key3",3],["set","key4",4],["set","key5",5],["set","key6",6],["set","key7",7],["set","key8",8],["set","key9",9],["set","key10",10],["set","key11",11],["set","key12",12],["set","key13",13],["set","key14",14],["set","key15",15],["set","key16",16],["set","key17",17],["set","key18",18],["set","key19",19],["set","key20",20],["set","key21",21],["set","key22",22],["set","key23",23],["set","key24",24],["set","key25",25],["set","key26",26],["set","key27",27],["set","key28",28],["set","key29",29],["set","key30",30],["set","key31",31],["size"],["get","key0"],["get","key31"]]
let __bench_result = solve(__bench_arg_0)
assert(__bench_result == [nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,nil,32,0,31],"B03-13")
