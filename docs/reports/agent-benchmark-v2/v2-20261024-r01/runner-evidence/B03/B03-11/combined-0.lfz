#42
fn bucket_hash(key) {
    var code_sum = 0
    for c in split("", key) {
        code_sum = (code_sum + ord(c)) % 8
    }
    code_sum
}

fn solve(operations) {
    let buckets = [[], [], [], [], [], [], [], []]
    let results = map((i) => nil, range(len(operations)))
    var count = 0
    var result_index = 0
    for operation in operations {
        let action = operation[0]
        if action == "size" {
            results[result_index] = count
        } else {
            let key = operation[1]
            let bucket_index = bucket_hash(key)
            var found = -1
            var i = 0
            while i < len(buckets[bucket_index]) {
                if buckets[bucket_index][i][0] == key {
                    found = i
                    break
                }
                i += 1
            }
            if action == "set" {
                if found == -1 {
                    buckets[bucket_index] = push([key, operation[2]], buckets[bucket_index])
                    count += 1
                } else {
                    buckets[bucket_index][found][1] = operation[2]
                }
                results[result_index] = nil
            } else if action == "get" {
                if found != -1 {
                    results[result_index] = buckets[bucket_index][found][1]
                }
            } else if action == "has" {
                results[result_index] = found != -1
            } else if action == "delete" {
                results[result_index] = found != -1
                if found != -1 {
                    buckets[bucket_index] = removeAt(found, buckets[bucket_index])
                    count -= 1
                }
            }
        }
        result_index += 1
    }
    results
}

let __bench_arg_0 = [["set","\${x}",42],["set","a\"\\b",-9],["get","\${x}"],["get","a\"\\b"]]
let __bench_result = solve(__bench_arg_0)
assert(__bench_result == [nil,nil,42,-9],"B03-11")
let __bench_repeat = solve([["set","\${x}",42],["set","a\"\\b",-9],["get","\${x}"],["get","a\"\\b"]])
assert(__bench_repeat == [nil,nil,42,-9],"repeat independent solve")
