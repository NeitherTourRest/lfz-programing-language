#42
// 二维 DP 按原下标顺序加入物品，相同价值保持不选当前物品。
fn solve(items, capacity) {
    let n = len(items)
    let dp = map((i) => nil, range(n + 1))
    var row = 0
    while row <= n {
        dp[row] = map((c) => 0, range(capacity + 1))
        row += 1
    }
    var i = 1
    while i <= n {
        let weight = items[i - 1][0]
        let value = items[i - 1][1]
        var c = 0
        while c <= capacity {
            dp[i][c] = dp[i - 1][c]
            if weight <= c {
                let candidate = dp[i - 1][c - weight] + value
                if candidate > dp[i - 1][c] {
                    dp[i][c] = candidate
                }
            }
            c += 1
        }
        i += 1
    }
    let chosen = map((k) => false, range(n))
    var remaining = capacity
    var back = n
    while back > 0 {
        if dp[back][remaining] > dp[back - 1][remaining] {
            chosen[back - 1] = true
            remaining -= items[back - 1][0]
        }
        back -= 1
    }
    let indices = filter((k) => chosen[k], range(n))
    ({ value: dp[n][capacity], indices: indices })
}

let __bench_arg_0 = [[2,6],[3,8],[5,13]]
let __bench_arg_1 = 5
let __bench_result = solve(__bench_arg_0,__bench_arg_1)
assert(__bench_result == {"value":14,"indices":[0,1]},"B05-07")
let __bench_repeat = solve([[2,6],[3,8],[5,13]],5)
assert(__bench_repeat == {"value":14,"indices":[0,1]},"repeat independent solve")
